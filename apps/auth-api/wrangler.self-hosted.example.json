{
  "name": "openbot-self-hosted-account",
  "main": "../../src/worker-entry.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    {
      "pattern": "account.example.test",
      "custom_domain": true
    }
  ],
  "vars": {
    "AUTH_EXPOSE_DEVELOPMENT_CODE": "false",
    "HOSTED_SERVERS_ENABLED": "false",
    "SITE_PUBLISH_ENABLED": "false",
    "EMAIL_SMTP_HOST": "smtp.example.test",
    "EMAIL_SMTP_PORT": "465",
    "EMAIL_SMTP_USERNAME": "auth@example.test",
    "EMAIL_FROM": "auth@example.test",
    "REMOTE_TICKET_KEY_ID": "self-hosted-1",
    "REMOTE_SIGNAL_URL": "wss://signal.example.test/v1/signal",
    "REMOTE_AUTH_WEBHOOK_URL": "https://signal.example.test/internal/auth-events",
    "SUPABASE_AUTH_URL": "https://project.example.test/auth/v1",
    "SUPABASE_PUBLISHABLE_KEY": "replace-with-publishable-key",
    "SUPABASE_OAUTH_CLIENT_ID": "replace-with-oauth-client-id"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openbot-self-hosted-auth",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "openbot-self-hosted-avatars"
    },
    {
      "binding": "SKILLS",
      "bucket_name": "openbot-self-hosted-skills"
    },
    {
      "binding": "SITES",
      "bucket_name": "openbot-self-hosted-sites"
    }
  ],
  "ratelimits": [
    {
      "name": "MARKETPLACE_INGRESS_RATE_LIMITER",
      "namespace_id": "2026082701",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "MARKETPLACE_MUTATION_RATE_LIMITER",
      "namespace_id": "2026082702",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "MARKETPLACE_UPLOAD_RATE_LIMITER",
      "namespace_id": "2026082703",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "SITE_REPORT_RATE_LIMITER",
      "namespace_id": "2026083101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "GITHUB_TOKEN_RATE_LIMITER",
      "namespace_id": "2026092911",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "LIVE_ACTIVITY_RATE_LIMITER",
      "namespace_id": "2026092901",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "2026110801",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
